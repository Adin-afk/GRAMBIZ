# Copy this file to .env in the same folder as docker-compose.yml to
# customize ports, credentials, or optional AI services. All values below
# are the defaults docker-compose.yml already falls back to, so an empty
# or missing .env works fine for a first run.

# --- Database ---
POSTGRES_DB=solapur_rural_db
POSTGRES_USER=solapur_user
POSTGRES_PASSWORD=solapur_pass
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change_me_to_a_long_random_string
SEED_DEMO_DATA=true

# --- Frontend ---
FRONTEND_PORT=5173
# Must be reachable from your BROWSER (not from inside Docker), since the
# frontend is a single-page app that runs on your machine, not in the
# container network. Leave as-is unless you changed BACKEND_PORT above.
VITE_API_BASE_URL=http://localhost:8000

# --- Optional AI services (the app runs fully without these) ---
GOOGLE_MAPS_API_KEY=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Google Gemini (SWOT / plain-language explanation layer)
# Get a key at https://aistudio.google.com/apikey - leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (read-aloud text-to-speech, multiple Indian languages)
# Get a key at https://elevenlabs.io/app/settings/api-keys - leave blank to disable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
