ENVIRONMENT=development
DEMO_MODE=true

# Point this at your own PostgreSQL+PostGIS+pgvector instance
DATABASE_URL=postgresql+psycopg2://solapur_user:solapur_pass@localhost:5432/solapur_rural_db

JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_MAPS_API_KEY=

# Optional AI services - the app remains fully functional without these
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Google Gemini (SWOT / plain-language explanation layer, app/ai/gemini_service.py)
# Get a key at https://aistudio.google.com/apikey - leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (read-aloud text-to-speech, app/ai/elevenlabs_service.py)
# Get a key at https://elevenlabs.io/app/settings/api-keys - leave blank to disable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
